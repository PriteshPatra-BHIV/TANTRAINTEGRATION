# ── REQUIRED ──────────────────────────────────────────────────────────────────
# Cryptographically random 64-char hex string. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
DGIC_TOKEN_SECRET_KEY=

# ── DGIC SERVICE ──────────────────────────────────────────────────────────────
DGIC_PORT=8000
DGIC_WORKERS=4
DGIC_LOG_LEVEL=INFO

# ── DOWNSTREAM SERVICES ───────────────────────────────────────────────────────
SARATHI_URL=http://localhost:8001
CORE_URL=http://localhost:8002
BUCKET_URL=http://localhost:8003
INSIGHTBRIDGE_URL=http://localhost:8004
ENFORCEMENT_URL=http://localhost:8005

# ── TIMEOUTS ──────────────────────────────────────────────────────────────────
SARATHI_TIMEOUT_S=10
CORE_TIMEOUT_S=10
BUCKET_TIMEOUT_S=10
ENFORCEMENT_TIMEOUT_S=10
INSIGHTBRIDGE_TIMEOUT_S=5

# ── RETRY CONFIG ──────────────────────────────────────────────────────────────
BUCKET_MAX_RETRIES=3
BUCKET_RETRY_DELAY_S=1.0
INSIGHTBRIDGE_MAX_RETRIES=2

# ── CIRCUIT BREAKER ───────────────────────────────────────────────────────────
# Number of consecutive failures before circuit opens
CB_FAILURE_THRESHOLD=5
# Seconds to wait before attempting recovery
CB_RECOVERY_TIMEOUT_S=30

# ── RATE LIMITING ─────────────────────────────────────────────────────────────
# Max requests per minute per client IP
RATE_LIMIT_PER_MINUTE=60

# ── SESSION ───────────────────────────────────────────────────────────────────
DGIC_SESSION_EXPIRY_MS=300000
DGIC_MAX_INVOCATIONS=100
DGIC_SARATHI_TIMEOUT_MS=30000

# ── OPENTELEMETRY ─────────────────────────────────────────────────────────────
# Leave blank to disable tracing export (traces still logged locally)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=dgic-intelligence
